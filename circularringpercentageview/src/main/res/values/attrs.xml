<resources>
    <declare-styleable name="CircularRingPercentageView">
        <attr name="crpv_progress" format="integer" />
        <attr name="crpv_max" format="integer" />
        <attr name="crpv_tickCount" format="integer" />
        <attr name="crpv_tickWidth" format="dimension" />
        <attr name="crpv_tickLength" format="dimension" />
        <attr name="crpv_progressColor" format="color" />
        <attr name="crpv_trackColor" format="color" />
        <attr name="crpv_drawMode">
            <enum name="complete" value="0" />
            <enum name="quarter" value="1" />
        </attr>
    </declare-styleable>
</resources>
