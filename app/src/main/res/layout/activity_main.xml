<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtitle" android:layout_marginBottom="24dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/complete" />
        <com.bluestrom.gao.customview.CircularRingPercentageView android:id="@+id/complete" android:layout_width="200dp" android:layout_height="200dp"
            android:contentDescription="@string/complete" app:crpv_drawMode="complete" app:crpv_progress="65" app:crpv_tickCount="200" app:crpv_tickWidth="2dp" app:crpv_tickLength="24dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/quarter" />
        <com.bluestrom.gao.customview.CircularRingPercentageView android:id="@+id/quarter" android:layout_width="200dp" android:layout_height="200dp"
            android:contentDescription="@string/quarter" app:crpv_drawMode="quarter" app:crpv_progress="65" app:crpv_progressColor="#536DFE" />
        <TextView android:id="@+id/progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="48dp" android:max="100" android:progress="65" android:contentDescription="@string/title" />
        <Button android:id="@+id/animate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/animate" />
        <Button android:id="@+id/reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reset" />
        <TextView android:id="@+id/tick_label" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/density" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/density" />
    </LinearLayout>
</ScrollView>
